{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoMagic",
  "version": "0.1.0",
  "identifier": "app.videomagic.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VideoMagic",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Local AI commentary studio",
    "longDescription": "Create AI-narrated videos locally with VideoMagic.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
